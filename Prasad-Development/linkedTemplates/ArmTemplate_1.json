						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[customer_procedure_return]",
							"storedProcedureParameters": {
								"countofrecords": {
									"value": "0",
									"type": "Int32"
								},
								"Region": {
									"value": {
										"value": "@pipeline().parameters.Region",
										"type": "Expression"
									},
									"type": "String"
								}
							}
						},
