							"referenceName": "AzureSqlDatabase1",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Script1",
						"type": "Script",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "AzureSqlDatabase1",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"parameters": [
										{
											"name": "output",
											"type": "Int64",
											"value": "0",
											"direction": "Output"
										}
									],
									"type": "Query",
									"text": "DECLARE @count INT;\n\nEXEC dbo.customer_procedure_return \n    @Region = 'USA', \n    @countofrecords = @count OUTPUT;\n\nSELECT @count AS total_records;"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"Region": {
						"type": "string"
					}
				},
				"annotations": []
			},
			"dependsOn": []
		},
