{
	"name": "PL_Padding_zero",
	"properties": {
		"activities": [
			{
				"name": "get_temp_value",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "temp_value",
					"value": {
						"value": "@substring(string(variables('init_value')),sub(length(string(variables('init_value'))),variables('paddingvalue')),variables('paddingvalue'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable1",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "get_temp_value",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "output_value",
					"value": {
						"value": "@sub(variables('init_value'),int(variables('temp_value')))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "log_pipeline_details",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Set variable1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "insert into dbo.pipeline values ('@{pipeline().Pipeline}',\n'@{pipeline().RunId}',formatDateTime(pipeline().TriggerTime),'yyyy-MM-dd HH:mm:ss'),'@{pipeline().TriggerType}',sub(formatDateTime(pipeline().TriggerTime),'yyyy-MM-dd HH:mm:ss'),formatDateTime(utcNow(),'yyyy-MM-dd HH:mm:ss')",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"variables": {
			"init_value": {
				"type": "Integer",
				"defaultValue": 65738
			},
			"paddingvalue": {
				"type": "Integer",
				"defaultValue": 3
			},
			"temp_value": {
				"type": "String"
			},
			"output_value": {
				"type": "Integer"
			}
		},
		"annotations": []
	}
}