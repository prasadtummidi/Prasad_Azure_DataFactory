{
	"name": "PL_swap_array",
	"properties": {
		"activities": [
			{
				"name": "left_elements",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "left_elements",
					"value": {
						"value": "@take(variables('Init_array'),pipeline().parameters.index1)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "right_elements",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "right_elements",
					"value": {
						"value": "@skip(variables('Init_array'),add(pipeline().parameters.index1,1))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Output_Variable",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "left_elements",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "right_elements",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "final_array",
					"value": {
						"value": "@createArray(variables('left_elements'),variables('Init_array')[pipeline().parameters.index2],variables('Init_array')[pipeline().parameters.index1],variables('right_elements'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable1",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Output_Variable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "final_result",
					"value": {
						"value": "@json(concat('[',replace(replace(string(variables('final_array')),'[' ,'' ),']',''),']'))",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"index1": {
				"type": "int",
				"defaultValue": 2
			},
			"index2": {
				"type": "int",
				"defaultValue": 3
			}
		},
		"variables": {
			"Init_array": {
				"type": "Array",
				"defaultValue": [
					54,
					32,
					68,
					43,
					59,
					62,
					71
				]
			},
			"final_array": {
				"type": "Array"
			},
			"left_elements": {
				"type": "Array"
			},
			"right_elements": {
				"type": "Array"
			},
			"final_result": {
				"type": "Array"
			}
		},
		"annotations": []
	}
}